<resources>
    <style name="Theme.ClearMind" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/violet</item>
        <item name="colorPrimaryDark">@color/violet_dark</item>
        <item name="colorAccent">@color/mint</item>
        <item name="android:windowBackground">@color/off_white</item>
        <item name="android:statusBarColor">@color/violet_dark</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="colorButtonNormal">@color/violet</item>
            <item name="buttonStyle">@style/ClearMindButton</item>
    </style>
    <style name="ClearMindButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_action</item>
        <item name="android:textColor">@color/off_white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:elevation">0dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
    </style>
</resources>
